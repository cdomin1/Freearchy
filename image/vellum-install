#!/bin/sh
# Vellum live installer — replaces bsdinstall's startbsdinstall on our
# media. Invoked once per console by /usr/libexec/bsdinstall/runconsoles
# (arg $1 is the console name, "primary" when multicons is disabled).

export HOME=/root

# boot_mute keeps the console muted into userland — unmute so the wizard
# paints, then wipe the splash for a clean hand-off. Three layers:
# kern.vt.boot_mute drops the vt splash, kern.consmute/conscontrol
# re-enable kernel console output.
sysctl kern.vt.boot_mute=0 >/dev/null 2>&1
sysctl kern.consmute=0 >/dev/null 2>&1
conscontrol mute off >/dev/null 2>&1

# Wire stdio to the real console before anything else: runconsoles can
# hand us a dead stdin, which leaves the TUI painting but deaf to keys.
exec </dev/console >/dev/console 2>&1

# RIS (full reset) clears leftover splash pixels and stale boot text —
# plain `clear` only blanks the text buffer and can race the unmute.
printf '\033c'
clear

# Same TERM dance as startbsdinstall: xterm on vt consoles, ask on serial.
kbdcontrol -d >/dev/null 2>&1
if [ $? -eq 0 ]; then
    TERM=xterm
    # Don't send ESC on left/right command keys.
    kbdcontrol -f 62 '' >/dev/null 2>&1
    kbdcontrol -f 63 '' >/dev/null 2>&1
    if [ -z "$EXTERNAL_VTY_STARTED" ]; then
        /usr/libexec/getty autologin ttyv3 &
        EXTERNAL_VTY_STARTED=1
    fi
else
    echo
    echo "Welcome to Vellum!"
    echo
    echo "Please choose the appropriate terminal type for your system."
    echo "Common console types are:"
    echo "   ansi     Standard ANSI terminal"
    echo "   vt100    VT100 or compatible terminal"
    echo "   xterm    xterm terminal emulator (or compatible)"
    echo
    echo -n "Console type [vt100]: "
    read TERM
    TERM=${TERM:-vt100}
fi
export TERM

resizewin -z 2>/dev/null

# syslogd writes *.err to /dev/console — that noise lands mid-frame on
# the TUI. Live media doesn't need it; dmesg keeps everything anyway.
service syslogd stop >/dev/null 2>&1

# Network once per boot: DHCP on every plausible NIC. The dist sets and the
# vellum payload are fetched over the network during install.
if [ ! -f /tmp/.vellum-net ]; then
    touch /tmp/.vellum-net
    for i in $(ifconfig -l); do
        case "$i" in lo*|ipfw*|pflog*|pfsync*|wlan*) continue ;; esac
        ifconfig "$i" up 2>/dev/null
        dhclient -b "$i" >/dev/null 2>&1
    done
    for _ in 1 2 3 4 5 6 7 8; do
        netstat -rn 2>/dev/null | grep -q '^default' && break
        sleep 1
    done
fi

if [ ! -x /usr/local/bin/vellum ] || [ ! -x /usr/local/bin/vellum-setup ]; then
    echo "vellum installer not found on this media; starting stock bsdinstall."
    sleep 2
    exec /usr/libexec/bsdinstall/startbsdinstall "$1"
fi

# Inline wizard (gum prompts → config → install engine). No alt-screen, so
# nothing below fights the console.
/usr/local/bin/vellum-setup
rc=$?

echo
echo "vellum-setup exited (status $rc)."
echo "Rerun with 'vellum-setup'; 'exit' returns to runconsoles."
/bin/sh
