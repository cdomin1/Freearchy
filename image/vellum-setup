#!/bin/sh
# vellum-setup — Omarchy-style inline installer wizard.
#
# Prompts are inline (gum choose/input/confirm) — no alt-screen, no raw
# mode, so console noise can't clobber the UI and stdin just works.
# Collects answers → writes a KEY=VALUE config → hands it to the Rust
# engine (vellum install-system --config) which owns all destructive
# work, prints [n/7] steps, and logs to /var/log/vellum-install.log.
#
# Unattended: $VELLUM_CONFIG, /vellum-install.conf on an already-mounted
# root, or the same file on any attached drive skips the wizard (the
# config's erase=yes is the confirmation).
#
# gum notes: pinned to 0.17 (bubbletea v1 — 2.x emits kitty-keyboard
# escapes vt(4) prints as literal "1u"). TERM=screen-16color stops gum's
# termenv from sending OSC 11 + DSR colour queries — on vt the query eats
# the user's first keystrokes while it waits for a reply. Colours must
# therefore be ANSI indices (kern.vt.color.* loader tunables in inject.sh
# make them render as the theme palette).

export HOME=/root
export TERM=${TERM:-xterm}
PATH=/usr/local/bin:/usr/local/sbin:$PATH

GUM=$(command -v gum 2>/dev/null)
[ -n "$NO_GUM" ] && GUM=   # escape hatch: NO_GUM=1 → plain prompts

LOG=/var/log/vellum-install.log
touch "$LOG" 2>/dev/null || LOG=/tmp/vellum-install.log

# Writable scratch dir — /tmp can be read-only or tiny on live media.
for d in /tmp /var/tmp /root; do
    if mkdir -p "$d" 2>/dev/null && touch "$d/.v" 2>/dev/null; then
        rm -f "$d/.v"; TMPDIR_V="$d"; break
    fi
done
CONF="$TMPDIR_V/vellum-install.conf"

# gum runs as TERM=screen-16color: ANSI-16 profile, zero terminal queries.
gum_() { TERM=screen-16color "$GUM" "$@"; }

# --- prompt primitives ----------------------------------------------------
# UI goes to stderr (like gum); the answer to stdout for $(...) capture.

say()  { printf '%s\n' "$*"; }
head_() { printf '\n\033[1;34m==> %s\033[0m\n' "$*"; }

choose() { # choose <header> <item...>
    _h="$1"; shift
    if [ -n "$GUM" ]; then
        printf '%s\n' "$@" | gum_ choose --header "$_h" --height 15 \
            --cursor.foreground=12 --header.foreground=8 --item.foreground=15
    else
        say "$_h" >&2; _i=1
        for _it in "$@"; do say "  $_i) $_it" >&2; _i=$((_i+1)); done
        printf 'Choice [1]: ' >&2; read -r _n || return 1
        _i=1
        for _it in "$@"; do
            if [ "${_n:-1}" = "$_i" ]; then say "$_it"; return; fi
            _i=$((_i+1))
        done
    fi
}

ask() { # ask <prompt> [default] [placeholder]
    _p="$1"; _d="$2"; _ph="$3"
    if [ -n "$GUM" ]; then
        # --placeholder for the default (a --value would take typed text as
        # an append, not a replace); empty answer → the default.
        _r=$(gum_ input --prompt "$_p " --width 60 --prompt.foreground=12 \
            --placeholder "${_ph:-$_d}")
        say "${_r:-$_d}"
    else
        printf '%s%s: ' "$_p" "${_d:+ [$_d]}" >&2; read -r _a || return 1
        say "${_a:-$_d}"
    fi
}

ask_pw() { # ask_pw <prompt>
    if [ -n "$GUM" ]; then
        gum_ input --password --prompt "$1 " --width 60 --prompt.foreground=12
    else
        stty -echo 2>/dev/null; printf '%s: ' "$1" >&2; read -r _a; stty echo 2>/dev/null; echo >&2
        say "$_a"
    fi
}

confirm() { # confirm <question>
    if [ -n "$GUM" ]; then
        gum_ confirm "$1" --affirmative "Yes" --negative "No" \
            --prompt.foreground=15 --selected.foreground=0 --selected.background=12
    else
        printf '%s [y/N] ' "$1" >&2; read -r _a || return 1
        [ "$_a" = "y" ] || [ "$_a" = "Y" ]
    fi
}

# --- unattended config ----------------------------------------------------
# Omarchy model: a vellum-install.conf on any drive skips the wizard.
find_config() {
    if [ -n "$VELLUM_CONFIG" ] && [ -f "$VELLUM_CONFIG" ]; then
        cp "$VELLUM_CONFIG" "$CONF"; return 0
    fi
    # Already mounted somewhere (e.g. injected into the ISO root)?
    for p in / /mnt /tmp/vmnt; do
        [ -f "$p/vellum-install.conf" ] && { cp "$p/vellum-install.conf" "$CONF"; return 0; }
    done
    mkdir -p /tmp/vmnt
    for dev in $(sysctl -n kern.disks 2>/dev/null); do
        for part in "/dev/${dev}"*; do
            [ "$part" = "/dev/${dev}" ] && continue
            [ -c "$part" ] || continue
            _fs=$(fstyp "$part" 2>/dev/null) || continue
            case "$_fs" in ufs|msdosfs|cd9660|ext2fs|ntfs) ;; *) continue ;; esac
            mount -r -t "$_fs" "$part" /tmp/vmnt 2>/dev/null || continue
            if [ -f /tmp/vmnt/vellum-install.conf ]; then
                cp /tmp/vmnt/vellum-install.conf "$CONF"
                umount /tmp/vmnt; chmod 600 "$CONF"
                say "Found $part/vellum-install.conf — unattended install."
                return 0
            fi
            umount /tmp/vmnt 2>/dev/null
        done
    done
    return 1
}

run_engine() {
    chmod 600 "$CONF"
    say "Log: $LOG"
    head_ "Installing Vellum"
    # Attached straight to the console — no tee, so fetch progress bars and
    # the engine's [n/7] step lines render in place. The engine appends to
    # the log itself.
    /usr/local/bin/vellum install-system --config "$CONF"
    rc=$?
    rm -f "$CONF"
    [ "$rc" = 0 ]
}

clear
printf '\033[1;34m'
cat <<'BANNER'
  __   _____  _    _    _   _ __  __
  \ \ / / __|| |  | |  | | | |  \/  |
   \ V /| _| | |__| |__| |_| | |\/| |
    \_/ |___||____|____|_____|_|  |_|

   A FreeBSD desktop. Omarchy-style, BSD-licensed.
BANNER
printf '\033[0m\n'

if find_config; then
    head_ "Unattended install"
    if run_engine; then
        say "Install complete."
    else
        say "Install failed — see $LOG"
        exit 1
    fi
    exit 0
fi

# --- keymap ---------------------------------------------------------------
head_ "Keyboard layout"
KM=$(choose "Choose your keymap" \
    "English (US)" "English (US, Dvorak)" "Danish" "Dutch" "Estonian" \
    "Finnish" "French" "French (Canada)" "German" "Italian" "Norwegian" \
    "Spanish" "Swedish" "Swiss German")
case "$KM" in
    "English (US)")        KEYMAP=us ;;
    "English (US, Dvorak)") KEYMAP=us.dvorak ;;
    Danish)  KEYMAP=dk ;;  Dutch) KEYMAP=nl ;;  Estonian) KEYMAP=ee ;;
    Finnish) KEYMAP=fi ;;  French) KEYMAP=fr ;;  "French (Canada)") KEYMAP=ca-fr ;;
    German)  KEYMAP=de ;;  Italian) KEYMAP=it ;; Norwegian) KEYMAP=no ;;
    Spanish) KEYMAP=es ;;  Swedish) KEYMAP=se ;; "Swiss German") KEYMAP=ch ;;
    *) KEYMAP=us ;;
esac
# Apply now so typing below matches the choice (same as the old TUI).
kbdcontrol -l "$KEYMAP" >/dev/null 2>&1

# --- disk -------------------------------------------------------------------
head_ "Target disk"
DISKS=$(/usr/local/bin/vellum install-system --list-disks 2>/dev/null)
[ -n "$DISKS" ] || { say "No candidate disks found (kern.disks empty)."; exit 1; }
# "name — description" per line; the name is the first field of the choice.
MENU=$(printf '%s\n' "$DISKS" | awk -F'\t' '{print $1 " — " $2}')
if [ -n "$GUM" ]; then
    PICK=$(printf '%s\n' "$MENU" | gum_ choose --header "Erase and install onto:" \
        --height 15 --cursor.foreground=12 --header.foreground=8 --item.foreground=15)
else
    say "Erase and install onto:" >&2
    _i=0; printf '%s\n' "$MENU" | while read -r _l; do _i=$((_i+1)); echo "  $_i) $_l" >&2; done
    printf 'Choice [1]: ' >&2; read -r _n
    case "$_n" in ''|*[!0-9]*) _n=1 ;; esac
    PICK=$(printf '%s\n' "$MENU" | sed -n "${_n}p")
fi
DISK=${PICK%% *}
[ -n "$DISK" ] || { say "No disk selected."; exit 1; }

# --- identity ---------------------------------------------------------------
head_ "Your account"
while :; do
    USERNAME=$(ask "Login name" "" "lowercase, e.g. carlos") || exit 1
    printf '%s' "$USERNAME" | grep -qE '^[a-z_][a-z0-9_-]{0,31}$' && break
    say "Use lowercase letters, digits, '_' or '-', starting with a letter."
done
while :; do
    FULLNAME=$(ask "Full name" "" "optional") || exit 1
    case "$FULLNAME" in *:*|*\"*|*$'\n'*) say "No ':' or quotes, please." ;; *) break ;; esac
done
while :; do
    EMAIL=$(ask "Email" "" "optional") || exit 1
    case "$EMAIL" in *:*|*\"*|*$'\n'*) say "No ':' or quotes, please." ;; *) break ;; esac
done
while :; do
    HOSTNAME=$(ask "Hostname" "vellum" "") || exit 1
    printf '%s' "$HOSTNAME" | grep -qE '^[a-z0-9]([a-z0-9.-]{0,61}[a-z0-9])?$' && break
    say "Lowercase letters, digits, '-' or '.', not starting/ending with one."
done

while :; do
    P1=$(ask_pw "Password") || exit 1
    [ -n "$P1" ] || { say "Password can't be empty."; continue; }
    P2=$(ask_pw "Confirm password") || exit 1
    [ "$P1" = "$P2" ] && break
    say "Passwords don't match — try again."
done

# --- confirm + go -----------------------------------------------------------
head_ "Summary"
say "  disk:     /dev/$DISK"
say "  hostname: $HOSTNAME"
say "  user:     $USERNAME${FULLNAME:+ ($FULLNAME)}"
say "  keymap:   $KEYMAP"
echo
confirm "Erase ALL of /dev/$DISK and install Vellum?" || { say "Aborted — nothing was written."; exit 1; }

umask 077
{
    echo "disk=$DISK";        echo "hostname=$HOSTNAME";  echo "username=$USERNAME"
    echo "fullname=$FULLNAME"; echo "email=$EMAIL";        echo "keymap=$KEYMAP"
    echo "password=$P1";      echo "erase=yes"
} > "$CONF"

if run_engine; then
    head_ "Done"
    say "Vellum is installed on /dev/$DISK."
    say "Remove the install media before rebooting."
    confirm "Reboot now?" && { sync; reboot; }
else
    say "Install failed — full log: $LOG"
    say "Rerun: vellum-setup   (shell: exit)"
    exit 1
fi
