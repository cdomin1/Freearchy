#!/bin/sh
# Vellum /etc/rc.suspend — runs as root before the kernel sleeps, no
# matter what asked for it (zzz, acpiconf -s, lid close, sleep button).

# Lock the X session before we go down — resume must land on the lock
# screen, not an open desktop. Find the session owner via the WM
# process rather than iterating every home directory (other users'
# slock would just fail and add noise).
xuser=$(ps -axo user=,comm= | awk '$2 == "vellum-wm" {print $1; exit}')
if [ -n "$xuser" ]; then
    # su -l gives the user's HOME so xauth finds the right cookie.
    su -l "$xuser" -c 'DISPLAY=:0 slock' 2>/dev/null &
    # let slock grab the display before the kernel cuts it
    sleep 0.5
fi

# USB-BT dongles can wedge mid-transfer; flush and let devd rebuild on
# resume rather than racing the suspend.
sync
sync
exit 0
