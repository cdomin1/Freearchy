#!/bin/sh
# Vellum /etc/rc.resume — runs as root right after the kernel wakes.
# Devices routinely come back half-dead; bounce the usual suspects.

# Wi-Fi (iwlwifi/rtw8x under linuxkpi) loses association across sleep —
# netif restart re-runs wpa_supplicant + DHCP for every interface
# (wpa_supplicant's rc script needs an interface arg, so not called alone).
service netif restart 2>/dev/null

# NVRAM clock can drift across suspend; ntpd will reslew on its own.
service ntpd restart 2>/dev/null

exit 0
