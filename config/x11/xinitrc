#!/bin/sh
# Freearchy X11 session — `startx` reads this.

# dbus session (quickshell-era bits + portals expect it)
if [ -x /usr/local/bin/dbus-launch ]; then
    eval "$(dbus-launch --sh-syntax --exit-with-session)"
fi

# compositor for the Hypr-ish look on X11 — animations need
# --experimental-backends (pijulius fork)
picom --experimental-backends --config \
    "$HOME/.config/freearchy/x11/picom.conf" -b 2>/dev/null &

# wallpaper (generated by freearchy install) — fall back to Tokyo Night bg
WALL="$HOME/.local/share/freearchy/wallpaper.png"
if command -v feh >/dev/null && [ -f "$WALL" ]; then
    feh --bg-fill "$WALL" &
else
    xsetroot -solid '#1a1b26'
fi
xsetroot -cursor_name left_ptr 2>/dev/null

exec freearchy-wm
