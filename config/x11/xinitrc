#!/bin/sh
# Vellum X11 session — `startx` reads this.

# dbus session (quickshell-era bits + portals expect it)
if [ -x /usr/local/bin/dbus-launch ]; then
    eval "$(dbus-launch --sh-syntax --exit-with-session)"
fi

# compositor for the Hypr-ish look on X11 — animations need
# --experimental-backends (pijulius fork)
picom --experimental-backends --config \
    "$HOME/.config/vellum/x11/picom.conf" -b 2>/dev/null &

# wallpaper (generated by vellum install) — fall back to Tokyo Night bg
WALL="$HOME/.local/share/vellum/wallpaper.png"
if command -v feh >/dev/null && [ -f "$WALL" ]; then
    feh --bg-fill "$WALL" &
else
    xsetroot -solid '#1a1b26'
fi
xsetroot -cursor_name left_ptr 2>/dev/null

# screen power: blank at 5m, DPMS standby/suspend/off at 10/15/20m
xset s on; xset s 300
xset +dpms; xset dpms 600 900 1200

# notifications (dunst isn't ported; xfce4-notifyd is dbus-activated
# anyway — this is just a safety net)
/usr/local/libexec/xfce4/notifyd/xfce4-notifyd 2>/dev/null &

# panel — vellum-wm reserves the top 28px via ReserveTop
polybar -c "$HOME/.config/polybar/config.ini" vellum &

exec vellum-wm
