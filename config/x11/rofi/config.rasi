// Freearchy rofi — colors come from the active theme symlink:
//   ~/.config/freearchy/current/theme/rofi.rasi
@import "~/.config/freearchy/current/theme/rofi.rasi"

configuration {
    font: "monospace 12";
    show-icons: true;
    drun-display-format: "{name}";
}

* {
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 640px;
    border: 2px;
    border-color: @accent;
    border-radius: 12px;
    background-color: @bg;
    padding: 12px;
}

mainbox {
    spacing: 8px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border-radius: 8px;
    padding: 8px 12px;
    children: [ prompt, entry ];
}

prompt { text-color: @accent; }
entry  { text-color: @fg; placeholder: "run…"; placeholder-color: @fg-dim; }

listview {
    lines: 8;
    spacing: 4px;
}

element {
    padding: 6px 10px;
    border-radius: 6px;
}
element selected {
    background-color: @accent;
    text-color: @bg;
}
element-text selected { text-color: @bg; }
