#!/bin/sh
# prime-run — run a program on the discrete GPU (hybrid graphics).
#   prime-run <cmd>        e.g. prime-run glxinfo -B
#
# The desktop itself always runs on the boot/iGPU — only what you launch
# through this wrapper hits the dGPU.
#
# `vellum install` writes /usr/local/etc/vellum/gpu.env with the offload
# GPU it detected: VELLUM_OFFLOAD=nvidia|dri|none and, for dri, the
# deterministic Mesa selector VELLUM_DRI_PRIME=pci-XXXX_BB_SS_F.

ENV_FILE=/usr/local/etc/vellum/gpu.env
[ -f "$ENV_FILE" ] && . "$ENV_FILE"

case "${VELLUM_OFFLOAD:-dri}" in
    nvidia)
        exec env \
            __NV_PRIME_RENDER_OFFLOAD=1 \
            __NV_PRIME_RENDER_OFFLOAD_PROVIDER=NVIDIA-G0 \
            __GLX_VENDOR_LIBRARY_NAME=nvidia \
            __VK_LAYER_NV_optimus=NVIDIA_only \
            "$@"
        ;;
    none)
        echo "prime-run: no offload GPU detected — running on the primary GPU" >&2
        exec "$@"
        ;;
    *)
        # DRI_PRIME accepts a /dev/dri path or the pci-XXXX_BB_SS_F tag
        exec env DRI_PRIME="${VELLUM_DRI_PRIME:-1}" "$@"
        ;;
esac
