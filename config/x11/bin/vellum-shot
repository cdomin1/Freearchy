#!/bin/sh
# vellum-shot — screenshots + colour picker (Omarchy Print-key behaviour).
#   vellum-shot full|window|select|color
set -u

dir="$HOME/Pictures"
mkdir -p "$dir"
out="$dir/vellum-$(date +%Y%m%d-%H%M%S).png"

notify() {
    command -v notify-send >/dev/null 2>&1 && notify-send "Screenshot" "$1"
}

case "${1:-}" in
    full)
        maim "$out" ;;
    window)
        win=$(xdotool getactivewindow) || exit 1
        maim -i "$win" "$out" ;;
    select)
        maim -s "$out" ;;
    color)
        hex=$(xcolor) || exit 1
        printf '%s' "$hex" | xclip -selection clipboard
        notify "$hex copied"
        exit 0 ;;
    *)
        echo "usage: vellum-shot full|window|select|color" >&2
        exit 1 ;;
esac

[ -f "$out" ] || exit 1
xclip -selection clipboard -t image/png -i "$out"
notify "$out (copied to clipboard)"
